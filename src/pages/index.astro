---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/sections/Hero.astro';
import TargetAudience from '../components/sections/TargetAudience.astro';
import ProblemSolution from '../components/sections/ProblemSolution.astro';
import CourseStructure from '../components/sections/CourseStructure.astro';
import LearningOutcomes from '../components/sections/LearningOutcomes.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import About from '../components/sections/About.astro';
import CelebrityTestimonials from '../components/sections/CelebrityTestimonials.astro';
import Pricing from '../components/sections/Pricing.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/sections/Footer.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <TargetAudience />
    <ProblemSolution />
    <CourseStructure />
    <LearningOutcomes />
    <Testimonials />
    <About />
    <CelebrityTestimonials />
    <Pricing />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>
