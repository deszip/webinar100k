import ProblemSolution from '../components/sections/ProblemSolution.astro';
import CourseStructure from '../components/sections/CourseStructure.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import About from '../components/sections/About.astro';
import CelebrityTestimonials from '../components/sections/CelebrityTestimonials.astro';
import Bonuses from '../components/sections/Bonuses.astro';
import Pricing from '../components/sections/Pricing.astro';
