---
import BaseLayout from '../layouts/BaseLayout.astro';

const instagramSupport = 'https://instagram.com/gaevskaya_smm';
---

<BaseLayout
  title="Сторінку не знайдено — Instagram Cashflow"
  description="Щось пішло не так. Напиши нам в Instagram — ми все вирішимо."
>
  <main class="err">
    <div class="container err__inner">
      <span class="err__code" aria-hidden="true">404</span>

      <h1>Щось пішло не так</h1>

      <p class="err__lead">
        Ця сторінка не знайдена або тимчасово недоступна. Якщо ти вже оплатив(-ла)
        вебінар і не отримав(-ла) доступ — напиши в Direct, і я надішлю посилання
        протягом кількох хвилин.
      </p>

      <a
        href={instagramSupport}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary err__cta"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="err__cta-icon">
          <rect
            x="2.5"
            y="2.5"
            width="19"
            height="19"
            rx="5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
          <circle
            cx="12"
            cy="12"
            r="4.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
          <circle cx="17.5" cy="6.5" r="1.3" fill="currentColor" />
        </svg>
        <span>Написати в Instagram — @gaevskaya_smm</span>
      </a>

      <a href="/" class="err__home">← На головну</a>
    </div>
  </main>
</BaseLayout>

<style>
  .err {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding-block: clamp(56px, 8vw, 96px);
  }

  .err__inner {
    max-width: 580px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .err__code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4.5rem, 18vw, 7rem);
    line-height: 1;
    background: var(--gradient-primary);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    letter-spacing: -0.02em;
  }

  .err h1 {
    margin: 0;
    font-size: clamp(1.6rem, 4.6vw, 2.2rem);
    line-height: 1.15;
  }

  .err__lead {
    color: var(--color-text);
    font-size: clamp(0.98rem, 2.3vw, 1.08rem);
    line-height: 1.55;
    margin: 0;
  }

  .err__cta {
    margin-top: 8px;
    width: min(100%, 420px);
    min-height: 60px;
    padding: 14px 22px;
    border-radius: 18px;
    font-size: 1rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    white-space: normal;
    text-align: center;
  }

  .err__cta-icon {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
  }

  .err__home {
    margin-top: 4px;
    color: var(--color-text-dim);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .err__home:hover {
    color: var(--color-text);
  }
</style>
