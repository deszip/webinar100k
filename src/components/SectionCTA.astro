---
import { webinarButton } from '../data/content';

interface Props {
  label?: string;
}

const { label = webinarButton.label } = Astro.props;
---

<div class="section-cta">
  <a href={webinarButton.href} class="btn btn-primary">{label}</a>
</div>

<style>
  .section-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(24px, 4vw, 36px);
  }
</style>
