---
import { webinarButton } from '../data/content';
---

<div class="floating-cta-bar">
  <a href={webinarButton.href} class="floating-cta">{webinarButton.label}</a>
</div>

<style>
  .floating-cta-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    display: flex;
    justify-content: center;
    padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
    background: rgba(255, 248, 251, 0.88);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -10px 30px rgba(49, 35, 52, 0.06);
  }

  .floating-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 4px 8px;
    font-weight: 800;
    font-size: 16px;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    background: var(--gradient-primary);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    transition: opacity 0.2s ease;
  }

  .floating-cta:hover {
    opacity: 0.78;
  }
</style>
