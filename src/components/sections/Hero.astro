---
import { hero } from '../../data/content';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <h1 class="hero__title">
      {
        hero.titleLines.map((row) => (
          <span class="hero__title-row">
            {row.map((chunk, i) => (
              <>
                {i > 0 && ' '}
                <span class="hero__title-chunk">{chunk}</span>
              </>
            ))}
          </span>
        ))
      }
    </h1>

    <p class="hero__author">{hero.authorLine}</p>

    <ul class="hero__bullets">
      {
        hero.bullets.map((b) => (
          <li>
            <svg class="hero__bullet-check" viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M4 10.5 L 8.5 15 L 16 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span set:html={b}></span>
          </li>
        ))
      }
    </ul>

    <div class="hero__price" aria-label={hero.price.eyebrow}>
      <span class="hero__price-eyebrow">{hero.price.eyebrow}</span>
      <div class="hero__price-row">
        <span class="hero__price-old">{hero.price.old}</span>
        <strong>{hero.price.current}</strong>
      </div>
      <span class="hero__price-saving">{hero.price.saving}</span>
      <span class="hero__price-note">{hero.price.note}</span>
    </div>

    <div class="hero__cta">
      <a href={hero.ctaPrimary.href} class="btn btn-primary">{hero.ctaPrimary.label}</a>
    </div>

  </div>

  <div class="hero__bg" aria-hidden="true">
    <span class="hero__bg-blob hero__bg-blob--ig"></span>
    <span class="hero__bg-blob hero__bg-blob--purple"></span>
    <span class="hero__bg-symbol hero__bg-symbol--uah">₴</span>
    <span class="hero__bg-symbol hero__bg-symbol--usd">$</span>
    <svg class="hero__bg-ig hero__bg-ig--tl" viewBox="0 0 56 56">
      <defs>
        <linearGradient id="heroIgGrad1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fcb045" />
          <stop offset="50%" stop-color="#e94077" />
          <stop offset="100%" stop-color="#7957d5" />
        </linearGradient>
      </defs>
      <rect
        x="3"
        y="3"
        width="50"
        height="50"
        rx="14"
        fill="none"
        stroke="url(#heroIgGrad1)"
        stroke-width="4"
      />
      <circle
        cx="28"
        cy="28"
        r="11"
        fill="none"
        stroke="url(#heroIgGrad1)"
        stroke-width="4"
      />
      <circle cx="42" cy="14" r="3.2" fill="url(#heroIgGrad1)" />
    </svg>

    <svg class="hero__bg-ig hero__bg-ig--br" viewBox="0 0 56 56">
      <defs>
        <linearGradient id="heroIgGrad2" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fcb045" />
          <stop offset="50%" stop-color="#e94077" />
          <stop offset="100%" stop-color="#7957d5" />
        </linearGradient>
      </defs>
      <rect
        x="3"
        y="3"
        width="50"
        height="50"
        rx="14"
        fill="none"
        stroke="url(#heroIgGrad2)"
        stroke-width="4"
      />
      <circle
        cx="28"
        cy="28"
        r="11"
        fill="none"
        stroke="url(#heroIgGrad2)"
        stroke-width="4"
      />
      <circle cx="42" cy="14" r="3.2" fill="url(#heroIgGrad2)" />
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(44px, 9vw, 88px) clamp(42px, 7vw, 86px);
    overflow: hidden;
  }

  .hero__inner {
    text-align: center;
    max-width: 1080px;
  }

  .hero__title {
    margin-bottom: 16px;
    font-size: clamp(1.85rem, 5.6vw, 3.2rem);
    line-height: 1.08;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .hero__title-row {
    display: block;
  }

  /* Mobile: each chunk on its own line → 4 lines total */
  .hero__title-chunk {
    display: block;
  }

  /* Desktop: chunks within a row sit on one line → 2 lines total */
  @media (min-width: 760px) {
    .hero__title-row {
      white-space: nowrap;
    }

    .hero__title-chunk {
      display: inline;
    }
  }

  .hero__author {
    max-width: 620px;
    margin: 0 auto 16px;
    color: var(--color-text);
    font-weight: 700;
    font-size: clamp(1rem, 2.5vw, 1.15rem);
  }

  .hero__bullets {
    display: inline-flex;
    flex-direction: column;
    gap: 12px;
    margin: 4px auto 26px;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .hero__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--color-text);
    font-size: clamp(0.98rem, 2.3vw, 1.08rem);
    line-height: 1.45;
    font-weight: 500;
  }

  .hero__bullets li span {
    flex: 1 1 auto;
    min-width: 0;
  }

  .hero__bullets strong {
    font-weight: 800;
    background: var(--gradient-primary);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero__bullet-check {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    color: var(--color-accent);
    filter: drop-shadow(0 2px 6px rgba(240, 79, 134, 0.25));
  }

  .hero__price {
    display: grid;
    gap: 8px;
    width: min(100%, 430px);
    margin: 0 auto 18px;
    padding: clamp(18px, 4vw, 24px);
    border-radius: 24px;
    background: var(--color-bg-elev);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }

  .hero__price-eyebrow,
  .hero__price-note {
    color: var(--color-text-muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .hero__price-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 12px;
  }

  .hero__price-old {
    color: var(--color-text-dim);
    text-decoration: line-through;
    font-size: clamp(1.1rem, 3vw, 1.35rem);
    font-weight: 700;
  }

  .hero__price strong {
    font-family: var(--font-display);
    font-size: clamp(3rem, 13vw, 5.5rem);
    line-height: 0.95;
    background: var(--gradient-primary);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .hero__price-saving {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--gradient-primary);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
  }

  .hero__cta {
    display: flex;
    justify-content: center;
    margin-bottom: 28px;
  }

  .hero__cta .btn {
    width: min(100%, 430px);
    min-height: 60px;
    height: auto;
    padding: 16px 28px;
    border-radius: 18px;
    font-size: clamp(1rem, 2.4vw, 1.15rem);
    font-weight: 800;
    white-space: normal;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  .hero__bg-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  /* Instagram-flavoured rainbow blob (yellow → orange → pink → purple) */
  .hero__bg-blob--ig {
    width: clamp(420px, 70vw, 680px);
    height: clamp(420px, 70vw, 680px);
    top: -22%;
    left: -18%;
    background: conic-gradient(
      from 200deg,
      rgba(252, 176, 69, 0.42),
      rgba(253, 29, 29, 0.32),
      rgba(233, 64, 119, 0.42),
      rgba(120, 86, 214, 0.34),
      rgba(252, 176, 69, 0.42)
    );
    opacity: 0.75;
  }

  .hero__bg-blob--purple {
    width: clamp(360px, 60vw, 560px);
    height: clamp(360px, 60vw, 560px);
    bottom: -28%;
    right: -18%;
    background: radial-gradient(
      circle,
      rgba(120, 86, 214, 0.34),
      rgba(233, 64, 119, 0.18) 55%,
      transparent 72%
    );
    opacity: 0.85;
  }

  /* Floating currency symbols (money theme) */
  .hero__bg-symbol {
    position: absolute;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1;
    background: var(--gradient-primary);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    user-select: none;
  }

  .hero__bg-symbol--uah {
    top: 4%;
    right: 3%;
    font-size: clamp(120px, 18vw, 230px);
    opacity: 0.18;
    transform: rotate(-12deg);
  }

  .hero__bg-symbol--usd {
    bottom: 6%;
    left: 4%;
    font-size: clamp(80px, 12vw, 160px);
    opacity: 0.14;
    transform: rotate(14deg);
  }

  /* Instagram camera icons */
  .hero__bg-ig {
    position: absolute;
    height: auto;
    opacity: 0.32;
  }

  .hero__bg-ig--tl {
    top: 16%;
    left: 5%;
    width: clamp(44px, 6vw, 64px);
    transform: rotate(-10deg);
  }

  .hero__bg-ig--br {
    bottom: 12%;
    right: 5%;
    width: clamp(72px, 9vw, 100px);
    transform: rotate(12deg);
    opacity: 0.36;
  }

  @media (max-width: 600px) {
    .hero__bg-symbol--usd,
    .hero__bg-ig--tl {
      display: none;
    }

    .hero__bg-ig--br {
      width: 56px;
      bottom: 8%;
      right: 8px;
      opacity: 0.3;
    }

    .hero__bg-symbol--uah {
      top: 2%;
      right: -10px;
      font-size: 150px;
      opacity: 0.14;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: 34px;
    }

    .hero__title {
      font-size: clamp(1.7rem, 9vw, 2.4rem);
    }

    .hero__price {
      width: 100%;
    }

    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__bullets {
      display: flex;
      width: 100%;
    }
  }
</style>
