---
import { hero } from '../../data/content';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <span class="hero__eyebrow">{hero.eyebrow}</span>

    <h1 class="hero__title">{hero.title}</h1>

    <p class="hero__subtitle">{hero.subtitle}</p>

    <div class="hero__cta">
      <a href={hero.ctaPrimary.href} class="btn btn-primary">{hero.ctaPrimary.label}</a>
      <a href={hero.ctaSecondary.href} class="btn btn-secondary">{hero.ctaSecondary.label}</a>
    </div>

    <ul class="hero__bullets">
      {hero.bullets.map((b) => <li>{b}</li>)}
    </ul>
  </div>

  <div class="hero__glow" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(72px, 14vw, 140px) clamp(48px, 9vw, 96px);
    overflow: hidden;
  }

  .hero__inner {
    text-align: center;
    max-width: 880px;
  }

  .hero__eyebrow {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--gradient-soft);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }

  .hero__title {
    margin-bottom: 20px;
  }

  .hero__subtitle {
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.55;
    max-width: 720px;
    margin: 0 auto 32px;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
  }

  .hero__bullets {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    color: var(--color-text-muted);
    font-size: 14px;
  }

  .hero__bullets li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero__bullets li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-3);
  }

  .hero__glow {
    position: absolute;
    inset: -20% 50% auto -20%;
    height: 480px;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.55), transparent 60%);
    filter: blur(80px);
    pointer-events: none;
    z-index: -1;
  }

  @media (max-width: 480px) {
    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__cta .btn {
      width: 100%;
    }
  }
</style>
