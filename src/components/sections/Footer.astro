---
import { footer } from '../../data/content';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <strong>{footer.brand}</strong>
      <p>{footer.description}</p>
    </div>

    <div class="site-footer__col">
      <h4>Контакти</h4>
      <a href={`mailto:${footer.contacts.email}`}>{footer.contacts.email}</a>
      <a href={`tel:${footer.contacts.phone.replace(/\s|\(|\)|-/g, '')}`}>
        {footer.contacts.phone}
      </a>
    </div>

    <div class="site-footer__col">
      <h4>Соцмережі</h4>
      {
        footer.socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        ))
      }
    </div>

    <div class="site-footer__col">
      <h4>Документи</h4>
      {footer.legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>

  <div class="site-footer__copy">
    <div class="container">{footer.copyright}</div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-elev);
    border-top: 1px solid var(--color-border);
    padding-top: 56px;
    margin-top: 32px;
  }

  .site-footer__inner {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
  }

  .site-footer__brand strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    background: var(--gradient-primary);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .site-footer__brand p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin-top: 8px;
  }

  .site-footer__col h4 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    margin-bottom: 14px;
  }

  .site-footer__col a {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    padding: 4px 0;
    transition: color 0.2s ease;
  }

  .site-footer__col a:hover {
    color: var(--color-text);
  }

  .site-footer__copy {
    border-top: 1px solid var(--color-border);
    margin-top: 40px;
    padding: 20px 0;
    color: var(--color-text-dim);
    font-size: 13px;
    text-align: center;
  }

  @media (min-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr repeat(3, 1fr);
      gap: 32px;
    }
  }
</style>
