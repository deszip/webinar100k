---
import { finalCta } from '../../data/content';
---

<section class="section final-cta">
  <div class="container final-cta__inner">
    <h2>{finalCta.title}</h2>
    <p>{finalCta.subtitle}</p>
    <a href={finalCta.cta.href} class="btn btn-primary">{finalCta.cta.label}</a>
  </div>
</section>

<style>
  .final-cta {
    padding-top: clamp(40px, 7vw, 88px);
  }

  .final-cta__inner {
    text-align: center;
    max-width: 820px;
  }

  .final-cta h2 {
    margin-bottom: 16px;
  }

  .final-cta p {
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    max-width: 640px;
    margin: 0 auto 28px;
  }
</style>
