---
import { bonuses } from '../../data/content';
import SectionCTA from '../SectionCTA.astro';
---

<section class="section bonuses">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{bonuses.eyebrow}</span>
      <h2>{bonuses.title}</h2>
      <p>{bonuses.lead}</p>
    </div>

    <article class="bonus-feature card">
      <div class="bonus-feature__media">
        <svg
          class="bonus-feature__svg"
          viewBox="0 0 320 360"
          role="img"
          aria-label="Конструктор розмовних Reels"
        >
          <defs>
            <linearGradient id="bonusIgGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#fcb045" />
              <stop offset="35%" stop-color="#fd1d1d" />
              <stop offset="70%" stop-color="#e94077" />
              <stop offset="100%" stop-color="#7957d5" />
            </linearGradient>
            <linearGradient id="bonusScreenGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2a1733" />
              <stop offset="100%" stop-color="#4a1f55" />
            </linearGradient>
            <linearGradient id="bonusPinkGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#f04f86" />
              <stop offset="100%" stop-color="#7957d5" />
            </linearGradient>
          </defs>

          <!-- Floating heart (left) -->
          <g transform="translate(18 96) rotate(-10)">
            <path
              d="M14 25 C 6 19 0 14 0 8 C 0 3.5 3.5 0 8 0 C 11 0 13 2 14 4 C 15 2 17 0 20 0 C 24.5 0 28 3.5 28 8 C 28 14 22 19 14 25 Z"
              fill="url(#bonusIgGrad)"
              opacity="0.85"
            />
          </g>

          <!-- Floating comment bubble (right) -->
          <g transform="translate(252 36)">
            <rect
              x="0"
              y="0"
              width="50"
              height="36"
              rx="12"
              fill="url(#bonusIgGrad)"
              opacity="0.9"
            />
            <path d="M14 36 L 19 46 L 24 36 Z" fill="url(#bonusIgGrad)" opacity="0.9" />
            <circle cx="15" cy="18" r="3" fill="white" />
            <circle cx="25" cy="18" r="3" fill="white" />
            <circle cx="35" cy="18" r="3" fill="white" />
          </g>

          <!-- Floating ₴ symbol (bottom-left) -->
          <text
            x="40"
            y="320"
            font-family="Inter, sans-serif"
            font-size="56"
            font-weight="800"
            fill="url(#bonusPinkGrad)"
            opacity="0.55"
            transform="rotate(-12 40 320)"
          >₴</text>

          <!-- Phone frame -->
          <rect
            x="80"
            y="40"
            width="160"
            height="290"
            rx="30"
            fill="url(#bonusScreenGrad)"
            stroke="url(#bonusIgGrad)"
            stroke-width="4"
          />

          <!-- Notch -->
          <rect
            x="142"
            y="50"
            width="36"
            height="6"
            rx="3"
            fill="rgba(255,255,255,0.18)"
          />

          <!-- REELS pill -->
          <rect
            x="100"
            y="72"
            width="58"
            height="22"
            rx="11"
            fill="rgba(255,255,255,0.16)"
          />
          <text
            x="129"
            y="87"
            font-family="Inter, sans-serif"
            font-size="11"
            font-weight="800"
            fill="white"
            text-anchor="middle"
            letter-spacing="0.06em"
          >REELS</text>

          <!-- Play button -->
          <circle cx="160" cy="172" r="34" fill="white" opacity="0.95" />
          <path d="M152 158 L 152 186 L 178 172 Z" fill="#e94077" />

          <!-- Side actions: heart, comment, share dots -->
          <g transform="translate(218 158)">
            <path
              d="M9 16 C 4 13 0 10 0 6 C 0 2.7 2.5 0 5.7 0 C 7.5 0 8.5 1 9 2 C 9.5 1 10.5 0 12.3 0 C 15.5 0 18 2.7 18 6 C 18 10 14 13 9 16 Z"
              fill="white"
            />
          </g>
          <g transform="translate(218 188)">
            <path
              d="M9 0 C 14 0 18 3.4 18 7.6 C 18 11.7 14 15 9 15 L 7 15 L 4 18 L 4 14.7 C 1.5 13.4 0 10.7 0 7.6 C 0 3.4 4 0 9 0 Z"
              fill="white"
              opacity="0.85"
            />
          </g>
          <g transform="translate(218 216)">
            <circle cx="3" cy="3" r="2" fill="white" opacity="0.85" />
            <circle cx="3" cy="11" r="2" fill="white" opacity="0.85" />
            <circle cx="3" cy="19" r="2" fill="white" opacity="0.85" />
          </g>

          <!-- Script template lines (the "constructor" cue) -->
          <rect
            x="100"
            y="240"
            width="120"
            height="6"
            rx="3"
            fill="rgba(255,255,255,0.7)"
          />
          <rect
            x="100"
            y="254"
            width="100"
            height="6"
            rx="3"
            fill="rgba(255,255,255,0.45)"
          />
          <rect
            x="100"
            y="268"
            width="110"
            height="6"
            rx="3"
            fill="rgba(255,255,255,0.45)"
          />
          <rect
            x="100"
            y="282"
            width="80"
            height="6"
            rx="3"
            fill="rgba(255,255,255,0.45)"
          />

          <!-- PDF badge -->
          <g transform="translate(96 304)">
            <rect
              x="0"
              y="0"
              width="42"
              height="18"
              rx="4"
              fill="url(#bonusPinkGrad)"
            />
            <text
              x="21"
              y="13"
              font-family="Inter, sans-serif"
              font-size="11"
              font-weight="800"
              fill="white"
              text-anchor="middle"
              letter-spacing="0.05em"
            >PDF</text>
          </g>
        </svg>
      </div>

      <div class="bonus-feature__body">
        <span class="bonus-feature__badge">{bonuses.badge}</span>
        <p class="bonus-feature__desc">{bonuses.description}</p>

        <ul class="bonus-feature__list">
          {
            bonuses.features.map((f) => (
              <li>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M4 10.5 L 8.5 15 L 16 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <SectionCTA label="Отримати доступ та бонус" />
  </div>
</section>

<style>
  .bonus-feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
    padding: clamp(22px, 4vw, 36px);
    overflow: hidden;
  }

  .bonus-feature__media {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: clamp(16px, 4vw, 28px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        circle at 30% 20%,
        rgba(252, 176, 69, 0.18),
        transparent 55%
      ),
      radial-gradient(
        circle at 80% 80%,
        rgba(121, 87, 213, 0.18),
        transparent 60%
      ),
      var(--gradient-soft);
    border: 1px solid var(--color-border);
  }

  .bonus-feature__svg {
    width: 100%;
    max-width: 320px;
    height: auto;
    display: block;
    filter: drop-shadow(0 18px 40px rgba(120, 86, 214, 0.22));
  }

  .bonus-feature__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .bonus-feature__badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--gradient-primary);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .bonus-feature__desc {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1rem, 2.4vw, 1.1rem);
    line-height: 1.55;
  }

  .bonus-feature__list {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bonus-feature__list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--color-text);
    font-size: clamp(0.95rem, 2.2vw, 1.02rem);
    line-height: 1.45;
    font-weight: 500;
  }

  .bonus-feature__list svg {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    color: var(--color-accent);
    filter: drop-shadow(0 2px 6px rgba(240, 79, 134, 0.25));
  }

  .bonus-feature__list span {
    flex: 1 1 auto;
    min-width: 0;
  }

  @media (min-width: 820px) {
    .bonus-feature {
      grid-template-columns: minmax(260px, 360px) 1fr;
      gap: 44px;
      padding: 40px;
    }
  }
</style>
