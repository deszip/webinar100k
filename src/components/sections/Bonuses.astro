---
import { bonuses } from '../../data/content';
import SectionCTA from '../SectionCTA.astro';
---

<section class="section bonuses">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Бонуси</span>
      <h2>{bonuses.title}</h2>
      <p>{bonuses.subtitle}</p>
    </div>

    <div class="grid-3">
      {
        bonuses.items.map((bonus, index) => (
          <article class="card bonus-card">
            <span class="bonus-card__number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{bonus.title}</h3>
            <p>{bonus.text}</p>
          </article>
        ))
      }
    </div>

    <SectionCTA />
  </div>
</section>

<style>
  .bonus-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bonus-card__number {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--gradient-soft);
    color: var(--color-accent);
    font-weight: 800;
  }

  .bonus-card h3 {
    margin: 0;
  }

  .bonus-card p {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
