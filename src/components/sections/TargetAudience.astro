---
import { audience } from '../../data/content';
---

<section class="section" id={audience.sectionId}>
  <div class="container">
    <div class="section-head">
      <h2>{audience.title}</h2>
      <p>{audience.subtitle}</p>
    </div>

    <div class="grid-2">
      {
        audience.personas.map((p) => (
          <article class="card persona">
            <h3>{p.title}</h3>
            <ul class="check-list">
              {p.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="audience__note">{audience.bottomNote}</p>
  </div>
</section>

<style>
  .persona h3 {
    margin-bottom: 20px;
    font-size: 1.25rem;
  }

  .audience__note {
    text-align: center;
    margin-top: 32px;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
</style>
